// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id           String   @id @default(cuid())
  code         String   @unique
  status       String   @default("LOBBY") // LOBBY, PLAYING, ROUND_END, FINISHED
  category     String   @default("film")
  maxRounds    Int      @default(10) @map("max_rounds")
  currentRound Int      @default(0) @map("current_round")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  players Player[]
  rounds  Round[]

  @@index([code])
  @@map("games")
}

model Player {
  id        String   @id @default(cuid())
  gameId    String   @map("game_id")
  name      String
  isHost    Boolean  @default(false) @map("is_host")
  score     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([gameId, name])
  @@index([gameId])
  @@map("players")
}

model Round {
  id          String   @id @default(cuid())
  gameId      String   @map("game_id")
  roundNumber Int      @map("round_number")
  songId      String   @map("song_id")
  songTitle   String   @map("song_title")
  songArtist  String?  @map("song_artist")
  category    String
  previewUrl  String?  @map("preview_url")
  createdAt   DateTime @default(now()) @map("created_at")

  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([gameId, roundNumber])
  @@index([gameId])
  @@map("rounds")
}

model Answer {
  id          String   @id @default(cuid())
  roundId     String   @map("round_id")
  playerId    String   @map("player_id")
  guess       String
  isCorrect   Boolean  @default(false) @map("is_correct")
  points      Int      @default(0)
  timeElapsed Int      @map("time_elapsed")
  createdAt   DateTime @default(now()) @map("created_at")

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId])
  @@index([roundId])
  @@index([playerId])
  @@map("answers")
}

